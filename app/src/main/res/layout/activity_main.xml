<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bgcolor"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >

            <Space
                android:layout_width="match_parent"
                android:layout_height="50dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="10dp"
                app:cardMaxElevation="10dp"
                app:cardUseCompatPadding="true"
                app:cardBackgroundColor="@color/blockcolor"
                android:layout_marginBottom="-20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/lineChart"
                        android:layout_width="match_parent"
                        android:layout_height="200dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingTop="10dp">
                        <ImageButton
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/leftarrow"
                            android:background="#00000000"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DD-MM-YY"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/blocktitle"/>

                        <ImageButton
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/outline_arrow_right_24"
                            android:background="#00000000"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="10dp"
                app:cardMaxElevation="10dp"
                app:cardUseCompatPadding="true"
                app:cardBackgroundColor="@color/blockcolor"
                android:layout_marginBottom="-20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TOTAL EXPENSE"
                        android:fontFamily="serif"
                        android:letterSpacing="0.1"
                        android:textSize="18sp"
                        android:textColor="@color/blocktitle"
                        android:layout_marginBottom="20dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:layout_marginRight="30dp">

                            <TextView
                                android:id="@+id/todayexpense"
                                android:layout_width="100dp"
                                android:layout_height="100dp"
                                android:background="@drawable/circle_background"
                                android:gravity="center"
                                android:text="150"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:textColor="@color/circletextcolor"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Today"
                                android:fontFamily="serif"
                                android:layout_marginTop="8dp"
                                android:textColor="@color/blocktitle"
                                android:textSize="16sp"/>
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="100dp"
                            android:background="#CCCCCC"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:layout_marginLeft="30dp">

                            <TextView
                                android:id="@+id/monthexpense"
                                android:layout_width="100dp"
                                android:layout_height="100dp"
                                android:background="@drawable/circle_background"
                                android:gravity="center"
                                android:text="4500"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:textColor="@color/circletextcolor"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="This Month"
                                android:fontFamily="serif"
                                android:layout_marginTop="8dp"
                                android:textColor="@color/blocktitle"
                                android:textSize="16sp"
                                />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="10dp"
                    app:cardMaxElevation="10dp"
                    app:cardUseCompatPadding="true"
                    app:cardBackgroundColor="@color/blockcolor"
                    android:layout_marginBottom="-10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="20dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DEBITED"
                            android:fontFamily="serif"
                            android:textSize="16sp"
                            android:textColor="@color/blocktitle"
                            android:layout_marginBottom="16dp"/>

                        <TextView
                            android:id="@+id/todaydebit"
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:background="@drawable/circle_background"
                            android:gravity="center"
                            android:text="150"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="@color/circletextcolor"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Today"
                            android:fontFamily="serif"
                            android:textColor="@color/blocktitle"
                            android:layout_marginTop="8dp"
                            android:textSize="14sp"/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#EEEEEE"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="16dp"/>

                        <TextView
                            android:id="@+id/monthdebit"
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:background="@drawable/circle_background"
                            android:gravity="center"
                            android:text="3200"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="@color/circletextcolor"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="This Month"
                            android:fontFamily="serif"
                            android:layout_marginTop="8dp"
                            android:textColor="@color/blocktitle"
                            android:textSize="14sp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="10dp"
                    app:cardMaxElevation="10dp"
                    app:cardUseCompatPadding="true"
                    app:cardBackgroundColor="@color/blockcolor"
                    android:layout_marginBottom="-10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="20dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CREDITED"
                            android:fontFamily="serif"
                            android:textSize="16sp"
                            android:textColor="@color/blocktitle"
                            android:layout_marginBottom="16dp"/>

                        <TextView
                            android:id="@+id/todaycredit"
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:background="@drawable/circle_background"
                            android:gravity="center"
                            android:text="500"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="@color/circletextcolor"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Today"
                            android:fontFamily="serif"
                            android:layout_marginTop="8dp"
                            android:textColor="@color/blocktitle"
                            android:textSize="14sp"/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#EEEEEE"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="16dp"/>

                        <TextView
                            android:id="@+id/monthcredit"
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:background="@drawable/circle_background"
                            android:gravity="center"
                            android:text="8000"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="@color/circletextcolor"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="This Month"
                            android:fontFamily="serif"
                            android:textColor="@color/blocktitle"
                            android:layout_marginTop="8dp"
                            android:textSize="14sp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="50dp"/>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="30dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_launcher_foreground"
            android:background="@drawable/circle_background"
            app:tint="@color/black" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>