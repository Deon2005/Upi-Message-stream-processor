<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="20dp"
    app:cardBackgroundColor="#161B22"
    app:cardCornerRadius="28dp"
    app:cardElevation="8dp"
    app:strokeWidth="1dp"
    app:strokeColor="#30363D">

    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/dialogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="Message Format"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02"/>

            <ImageButton
                android:id="@+id/closeButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/close_x_svgrepo_com"
                android:scaleType="centerInside"
                app:tint="#8B949E"
                android:contentDescription="Close dialog" />
        </RelativeLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SENDER ID"
            android:textColor="#8B949E"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#0D1117"
            app:cardCornerRadius="14dp"
            app:strokeWidth="0dp"
            android:layout_marginBottom="24dp">

            <EditText
                android:id="@+id/senderid"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@null"
                android:hint="e.g. KGBANK"
                android:textColorHint="#484F58"
                android:textColor="#FFFFFF"
                android:inputType="textCapCharacters"
                android:textSize="15sp"
                android:paddingHorizontal="16dp"/>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TRANSACTION TYPE"
            android:textColor="#8B949E"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/radiogp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:checkedButton="@+id/radio0"
            android:layout_marginBottom="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/radio0"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Debit"
                android:textColor="#FFFFFF"
                app:strokeColor="#30363D"
                app:backgroundTint="@null"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/radio1"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Credit"
                android:textColor="#FFFFFF"
                app:strokeColor="#30363D"
                app:backgroundTint="@null"/>
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SAMPLE SMS"
            android:textColor="#8B949E"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#0D1117"
            app:cardCornerRadius="14dp"
            app:strokeWidth="0dp"
            android:layout_marginBottom="28dp">

            <EditText
                android:id="@+id/samplesms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="4"
                android:background="@null"
                android:hint="Paste the exact SMS here..."
                android:textColorHint="#484F58"
                android:textColor="#FFFFFF"
                android:inputType="textMultiLine"
                android:gravity="top|start"
                android:textSize="15sp"
                android:padding="16dp"/>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/submitbtn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Submit"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#1F6FEB"
            app:cornerRadius="28dp"
            app:elevation="0dp"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>