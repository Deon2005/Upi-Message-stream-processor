<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="20dp"
    app:cardCornerRadius="28dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="#161B22"
    app:strokeWidth="1dp"
    app:strokeColor="#30363D">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/dialog_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Transaction Details"
            android:textAlignment="center"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginBottom="24dp"/>

        <EditText
            android:id="@+id/dialog_input_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:hint="₹0"
            android:textColorHint="#484F58"
            android:textColor="#FFFFFF"
            android:inputType="numberDecimal"
            android:textSize="48sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/dialog_toggle_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:checkedButton="@id/btn_type_expense"
            android:layout_marginBottom="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_type_expense"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Expense"
                android:textColor="#FFFFFF"
                app:strokeColor="#30363D"
                app:backgroundTint="@null"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_type_income"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Income"
                android:textColor="#FFFFFF"
                app:strokeColor="#30363D"
                app:backgroundTint="@null"/>
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#0D1117"
            app:cardCornerRadius="14dp"
            app:strokeWidth="0dp"
            android:layout_marginBottom="12dp">

            <EditText
                android:id="@+id/dialog_input_desc"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@null"
                android:hint="Payee / Description (e.g. Groceries)"
                android:textColorHint="#8B949E"
                android:textColor="#FFFFFF"
                android:inputType="textCapWords"
                android:textSize="15sp"
                android:paddingHorizontal="16dp"/>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#0D1117"
            app:cardCornerRadius="14dp"
            app:strokeWidth="0dp"
            android:layout_marginBottom="12dp">

            <EditText
                android:id="@+id/dialog_input_source"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@null"
                android:hint="Payment Mode (e.g. Cash, HDFC Card)"
                android:textColorHint="#8B949E"
                android:textColor="#FFFFFF"
                android:inputType="textCapWords"
                android:textSize="15sp"
                android:paddingHorizontal="16dp"/>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#0D1117"
            app:cardCornerRadius="14dp"
            app:strokeWidth="0dp"
            android:layout_marginBottom="28dp">

            <TextView
                android:id="@+id/dialog_text_date"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Select Date"
                android:textColor="#8B949E"
                android:textSize="15sp"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                app:drawableEndCompat="@android:drawable/ic_menu_today"
                app:drawableTint="#8B949E"/>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dialog_btn_cancel"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="56dp"
                android:text="Cancel"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dialog_btn_save"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="56dp"
                android:text="Save"
                android:textColor="#FFFFFF"
                app:backgroundTint="#1F6FEB"
                app:cornerRadius="28dp"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>